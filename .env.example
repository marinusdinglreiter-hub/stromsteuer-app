# =============================================================================
# Stromsteuer-App — Environment-Variablen (Partnerkanzlei-Modell)
# Kopiere diese Datei zu `.env` und fuelle die Werte. `.env` ist gitignored.
# Pflicht = die App/Funktion ist ohne diesen Wert nicht produktionsreif.
# =============================================================================

# --- Datenbank (Supabase EU/Frankfurt) — PFLICHT --------------------------------
# Pooler-URL fuer die App (mit pgbouncer)
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direkter Connection-String fuer Prisma Migrate
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Backoffice (Partnerkanzlei) — PFLICHT in Produktion ------------------------
# Basic-Auth fuer /admin/*. Ohne ADMIN_PASSWORD ist das Backoffice gesperrt (503).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- Cron — PFLICHT in Produktion ----------------------------------------------
# Schuetzt /api/cron/expire. Ohne Wert ist der Endpoint deaktiviert (503).
# In Vercel als Env-Variable hinterlegen — Vercel setzt den Bearer-Header automatisch.
CRON_SECRET=""

# --- Supabase Storage (Belege + generierte Dateien) — PFLICHT fuer Uploads ------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_BELEGE="belege"
SUPABASE_BUCKET_GENERATED="generated"

# --- E-Mail (Resend) — PFLICHT fuer Versand (sonst no-op/Console) ---------------
RESEND_API_KEY=""
# Muss in Resend verifiziert sein:
RESEND_FROM_EMAIL="Stromsteuer-Erstattung <no-reply@example.de>"
# Postfach der Partnerkanzlei (erhaelt neue Antraege):
KANZLEI_EMAIL_INBOX="kanzlei@example.de"

# --- OCR (AWS Textract) — optional (Fallback: manuelle Eingabe) -----------------
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- App / Sonstiges ------------------------------------------------------------
# Oeffentliche Basis-URL (fuer Links in E-Mails). PFLICHT in Produktion.
APP_BASE_URL="http://localhost:3000"
# Tage bis unfertige Antraege automatisch geloescht werden (7–365).
DRAFT_TTL_DAYS="90"

# --- Monitoring — optional ------------------------------------------------------
SENTRY_DSN=""
PLAUSIBLE_DOMAIN=""
