// Prisma schema — Partnerkanzlei-Modell mit Festpreis (TODO.md, Stand 27.09.2026).
//
// Ein Mandant (Unternehmen) stellt je Verbrauchsjahr einen Antrag. Der Antrag
// wird vom Kunden im Wizard gestartet, von uns aufbereitet und von der
// Partnerkanzlei im Zoll-Portal gestellt. Identifikation des Antrags laeuft
// ueber sessionToken (Cookie + Magic-Link), kein Login.
//
// Feldnamen fuer den Hauptantrag folgen docs/formulare/1453-feldspezifikation.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Mandant {
  id                String  @id @default(cuid())
  firmenname        String
  rechtsform        String?
  geschaeftsfuehrer String?
  vorname           String?
  nachname          String?
  email             String?
  telefon           String?
  strasse           String?
  plz               String?
  ort               String?

  // Formular 1453 Abschnitt 1
  steuernummer       String?
  ustIdNr            String?
  handelsregister    String? // HRB
  wzCode             String? // Klassifikation der Wirtschaftszweige
  unternehmensnummer String? // Zoll-Unternehmensnummer
  hauptzollamt       String? // nach Geschaeftssitz, NICHT nach Lieferstelle

  // Formular 1453 Abschnitt 4, ohne IBAN kein Antrag
  kontoinhaber String?
  iban         String?
  bic          String?

  // § 2 Nr. 3 StromStG (Produzierendes Gewerbe) oder Nr. 5 (Land-/Forstwirtschaft)
  unternehmensart Unternehmensart?

  antraege     Antrag[]
  portalZugang PortalZugang?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Unternehmensart {
  PRODUZIERENDES_GEWERBE
  LAND_FORSTWIRTSCHAFT
}

model Antrag {
  id           String       @id @default(cuid())
  sessionToken String       @unique
  status       AntragStatus @default(DRAFT)

  mandant   Mandant? @relation(fields: [mandantId], references: [id], onDelete: SetNull)
  mandantId String?

  // Step 1 — Calculator / Antragsdaten
  antragsjahr    Int?
  branche        String?
  geschaetzteKwh Int?

  entlastungsabschnitt             Entlastungsabschnitt @default(KALENDERJAHR)
  schaetzungNach17b                Boolean? // Formular 1453 Punkt 5
  beschreibungTaetigkeitVorgelegt  BeschreibungStatus? // Punkt 2
  stromAnDritteGeleistet           Boolean? // Punkt 6, erste Zeile
  nutzenergieAnDritteWeitergegeben Boolean? // Punkt 6, zweite Zeile
  entnahmeDurchDritten             Boolean? // Punkt 7
  /// Selbsterklaerung zu staatlichen Beihilfen (Formular 1139) liegt vor.
  beihilfeSelbsterklaerungVorhanden Boolean?

  // Preis nach Preistabelle, eingefroren bei Vertragsschluss
  preisEur            Decimal? @db.Decimal(12, 2)
  preisTabelleVersion String?
  istFolgejahr        Boolean  @default(false)

  // Step 2a — Lieferstellen (in eigener Tabelle)
  lieferstellen         Lieferstelle[]
  nutzenergieEmpfaenger NutzenergieEmpfaenger[]

  // Unveraenderliche Eingabe-/Aktions-Historie (Audit-Trail)
  auditEvents AuditEvent[]

  // Step 2b — Triage (Ja/Nein + bedingte Schaetzungen)
  triageKleinsteRechtsperson  Boolean?
  triageKeineFinanzschwierig  Boolean? // UiS-Check; true = entlastungsfaehig
  triageKeineEuRueckforderung Boolean? // true = ok, false = Hardstop
  triagePrivatnutzung         Boolean?
  triagePrivatnutzungKwh      Int?
  triageEAutoLaden            Boolean?
  triageEAutoKwh              Int?
  triageEnergieAnDritte       Boolean? // true => needs1456 Flag

  // Server-berechnete Werte (idempotent aus Lieferstellen + Triage abgeleitet)
  bruttoKwh        Int?
  nettoKwh         Int?
  bruttoErstattung Decimal? @db.Decimal(12, 2)

  // Step 3b — zwei getrennte Vertraege mit je eigener Signatur (TODO 1.4)
  agbAccepted           Boolean?
  vertretungsBerechtigt Boolean?
  mandatSignerName      String?
  mandatSignerIp        String?
  mandatSignerUserAgent String?
  consentVersion        String? // Version des zugestimmten Wortlauts (legalTexts.CONSENT_VERSION)
  consentTextSha256     String? // SHA-256-Hex des kanonischen Einwilligungstexts
  mandatTimestampKey    String? // Reserve: Storage-Key eines RFC-3161-Zeitstempels (optional)

  aufbereitungAccepted        Boolean?
  aufbereitungSignedAt        DateTime?
  aufbereitungSignaturePngKey String?
  aufbereitungPdfKey          String?
  aufbereitungPdfSha256       String?

  kanzleimandatAccepted        Boolean?
  kanzleimandatSignedAt        DateTime?
  kanzleimandatSignaturePngKey String?
  kanzleimandatPdfKey          String?
  kanzleimandatPdfSha256       String?

  // Uebergabe an Kanzlei
  kanzleiPaketKey String?
  submittedAt     DateTime?
  hzaDecisionAt   DateTime?
  hzaAmount       Decimal?  @db.Decimal(12, 2)
  payoutAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([status])
  @@index([expiresAt])
  @@index([mandantId])
}

enum Entlastungsabschnitt {
  KALENDERJAHR
  HALBJAHR
  QUARTAL
  MONAT
}

enum BeschreibungStatus {
  BEREITS_VORGELEGT
  LIEGT_BEI
}

model Lieferstelle {
  id       String @id @default(cuid())
  antrag   Antrag @relation(fields: [antragId], references: [id], onDelete: Cascade)
  antragId String

  firmenname String
  adresse    String
  plz        String?
  hza        String?

  // Formular 1453 Seite 2: Menge dreigeteilt
  kwhEigenbetrieblich Int // Spalte 3: betriebliche Zwecke, ohne Sp. 4 und 5
  kwhNutzenergiePG    Int @default(0) // Spalte 4: Nutzenergie, genutzt von anderen Unternehmen des Produzierenden Gewerbes
  kwhNutzenergieLuF   Int @default(0) // Spalte 5: dito Land-/Forstwirtschaft

  // Aus der Rechnung gelesen (OCR) — Grundlage fuer das Pruefprotokoll
  versorger             String?
  zeitraumVon           DateTime?
  zeitraumBis           DateTime?
  stromsteuerGezahltEur Decimal?  @db.Decimal(12, 2)

  belegFileKeys String[] // Supabase Storage Keys
  ocrConfidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([antragId])
}

model NutzenergieEmpfaenger {
  id                        String          @id @default(cuid())
  antrag                    Antrag          @relation(fields: [antragId], references: [id], onDelete: Cascade)
  antragId                  String
  firmenname                String
  adresse                   String
  kategorie                 Unternehmensart
  mengeKwh                  Int
  selbsterklaerungVorhanden Boolean         @default(false)

  @@index([antragId])
}

model PortalZugang {
  id                      String            @id @default(cuid())
  mandant                 Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  mandantId               String            @unique
  elsterStatus            ElsterStatus      @default(UNBEKANNT)
  portalKontoStatus       PortalKontoStatus @default(OFFEN)
  vollmachtStatus         VollmachtStatus   @default(OFFEN)
  beteiligtenNummer       String?
  zugangscodeEingeloestAt DateTime?
  scopeGeprueftAt         DateTime?
  scopeGeprueftVon        String?
  bescheidZustellungAktiv Boolean           @default(false)
  eskalationsstufe        Int               @default(0)
  letzteErinnerungAt      DateTime?
  notizen                 String?
}

enum ElsterStatus {
  UNBEKANNT
  VORHANDEN
  BEIM_STB
  FEHLT
  BEANTRAGT
}

enum PortalKontoStatus {
  OFFEN
  REGISTRIERT
}

enum VollmachtStatus {
  OFFEN
  ERTEILT
  CODE_EINGELOEST
  AKTIV
  ABGELAUFEN
  SCOPE_FALSCH
}

enum AntragStatus {
  DRAFT
  SIGNED
  PENDING_REVIEW
  SUBMITTED
  APPROVED
  PAID
  REJECTED
  EXPIRED
}

/// Append-only Audit-Trail: jede relevante Aktion an einem Antrag.
/// Es darf ausschliesslich INSERT geben. UPDATE/DELETE werden in Code nie
/// ausgefuehrt und zusaetzlich per DB-Trigger hart blockiert
/// (Migration `1_audit_immutable`).
model AuditEvent {
  id        String         @id @default(cuid())
  antrag    Antrag?        @relation(fields: [antragId], references: [id], onDelete: Cascade)
  antragId  String?
  type      AuditEventType
  actor     AuditActor     @default(CUSTOMER)
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([antragId])
  @@index([type])
  @@index([createdAt])
}

enum AuditActor {
  CUSTOMER
  KANZLEI
  SYSTEM
}

enum AuditEventType {
  APPLICATION_CREATED
  CALC_UPDATED
  TRIAGE_UPDATED
  FIRMA_UPDATED
  MANDAT_SIGNED
  APPLICATION_SUBMITTED
  STATUS_CHANGED
  DRAFT_EXPIRED
  AUFBEREITUNG_SIGNED
  KANZLEIMANDAT_SIGNED
  DATENBLATT_ERZEUGT
}
